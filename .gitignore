.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
.claude/

# Config local con credenciales de BD — copiar desde api/config.local.php.example
api/config.local.php
.env

# Respaldos exportados desde Perfil (contienen datos reales, no van al repo)
bitacora-backup-*.json

# Backups automáticos (api/db/backup_export.php) — datos reales, protegidos
# también por api/db/backups/.htaccess, pero por las dudas no van al repo
api/db/backups/*.json

# Zips de despliegue armados para subir por FTP — artefacto local, no código
/producción/

# Caché en disco de GIFs/imágenes del dataset de ejercicios (api/exercise_media.php)
# — se repuebla solo pidiéndolos de nuevo, no hace falta versionarlos.
api/media_cache/*/*

# Dataset crudo descargado por scripts/build-exercises-dataset.php — se
# vuelve a bajar con solo correr el script, no hace falta versionarlo.
scripts/.cache/
